      "description": "Return kpi_results rows for the most recent year."
    },
    "product_category_mapping": {
      "file": "d:\\Zenith AI\\MAS_UseCase_V3\\created_tools\\product_category_mapping.py",
      "description": "Creates a mapping between product_id and a product category (flagship, mid-range, entry-level, accessory). The mapping is based on product_id ranges.  The function reads a CSV file containing the mapping from product_id to product category. The file is located in the same directory as the script. Data quality checks: Ensures that product_id is an integer and product_category is a string. Validations: Checks if the product_id is within the defined ranges and the product_category is one of the allowed values. Failure modes: If the CSV file is missing or corrupted, the function returns an empty dictionary. If a product_id is not found in the mapping, it is assigned to 'Unknown'. Performance notes: The function reads the CSV file into a pandas DataFrame and creates a dictionary for fast lookup. The mapping is stored in memory for subsequent calls. The function is optimized for speed and memory usage."
    }
  },
  "agents": {
    "WestRevenueAnalyst": {
      "file": "d:\\Zenith AI\\MAS_UseCase_V3\\created_agents\\WestRevenueAnalyst.py",
      "description": "Analyze West region's sales performance, stockout rates, and potential drivers to identify opportunities for revenue growth while maintaining stockout constraints. Uses sales data and kpi data to understand trends and potential levers."
    },
    "ProfitabilityAnalyst": {
      "file": "d:\\Zenith AI\\MAS_UseCase_V3\\created_agents\\ProfitabilityAnalyst.py",
      "description": "Analyze sales data to identify areas for profit improvement, considering revenue, cost (inferred from price and sales), and marketing spend. Identify products and regions with high profit margins and those with low margins. Suggest strategies to improve profitability, such as optimizing marketing spend or adjusting pricing."
    },
    "ProfitDriverAnalyst": {
      "file": "d:\\Zenith AI\\MAS_UseCase_V3\\created_agents\\ProfitDriverAnalyst.py",
      "description": "Identify key drivers of profit (revenue - cost) by analyzing KPIs, including marketing spend, competitor price, inventory, and stockouts. The agent will use the kpi_results data to understand the relationship between these factors and profit, and make recommendations on how to optimize these factors to increase profit. It will also consider product categories."
    }
  },
